<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  parallel="classes" thread-count="3"
  Each class runs in its own thread. This is safe because DriverManager keeps
  the WebDriver in a ThreadLocal, so the three browsers never share state.
-->
<suite name="SauceDemo Regression Suite" parallel="classes" thread-count="3" verbose="1">

  <listeners>
    <listener class-name="com.amitsaini.qa.listeners.TestListener"/>
  </listeners>

  <test name="UI Regression">
    <classes>
      <class name="com.amitsaini.qa.tests.LoginTests"/>
      <class name="com.amitsaini.qa.tests.InventoryTests"/>
      <class name="com.amitsaini.qa.tests.CheckoutTests"/>
    </classes>
  </test>

</suite>
